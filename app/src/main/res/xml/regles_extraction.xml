<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 et plus : sauvegarde dans le cloud et transfert d'appareil. Tout reste sauvegardé comme avant,
     sauf le coffre des clés API (v1.18) : ses clés du Keystore ne suivent pas, il serait illisible ailleurs. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="cles_llm.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="cles_llm.xml" />
    </device-transfer>
</data-extraction-rules>
